<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SexyPackages</AssemblyName>
    <RootNamespace>SexyPackages</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <FileAlignment>512</FileAlignment>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>Compiled\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <OutputPath>Compiled\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <TieredCompilation>false</TieredCompilation>
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	<PackageReference Include="SkiaSharp" Version="3.119.1"/>
  </ItemGroup>
  
  <ItemGroup>
  
    <Reference Include="BlossomLib">
      <HintPath>Dependencies\BlossomLib.dll</HintPath>
    </Reference>
	
		  <Reference Include="SexyParsers">
      <HintPath>Dependencies\SexyParsers.dll</HintPath>
      </Reference>
	  
	  <Reference Include="SexyCompressors">
      <HintPath>Dependencies\SexyCompressors.dll</HintPath>
      </Reference>
	  
	  	  <Reference Include="SexyCryptor">
      <HintPath>Dependencies\SexyCryptor.dll</HintPath>
      </Reference>
	  
	  	  <Reference Include="TextureTranscoder">
      <HintPath>Dependencies\TextureTranscoder.dll</HintPath>
      </Reference>
	
  </ItemGroup>
  
</Project>